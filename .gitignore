# ==============================================================================
# Git Ignore Configuration for Adaptive Underworld Recon Array (A.U.R.A.)
# v0.2.1-alpha2 | Pure Modular Architecture
# ==============================================================================

# 1. Neural Model Weights & Large AI Artifacts (Local Execution Only)
*.gguf
*.bin
*.onnx
*.safetensors
*.pt
*.pth
*.ckpt
models/*
**/models/*
!models/.gitkeep
!**/models/.gitkeep
training/
**/training/

