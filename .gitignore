# ==============================================================================
# Git Ignore Rules for A.U.R.A. EVE Tool
# ==============================================================================

# Neural Model Weights (Exceeds GitHub 100MB / 2GB limit)
*.gguf
*.bin
*.onnx
*.safetensors
*.pt
models/
**/models/

# Large Binaries, Installers, & Compiled Libraries (>50MB / 100MB GitHub limit)
*.exe
*.dll
*.so
*.dylib
*.whl
*.zip
*.7z
*.tar.gz

# Virtual Environments
venv/
venv_app/
env/
ENV/
.venv/
requirements/venv/
**/venv/
**/venv_app/
**/requirements/venv/

# PyInstaller & Distribution Packages
build/
dist/
A.U.R.A Distro/
**/A.U.R.A Distro/
AURA_Standalone_Windows/
A.U.R.A. Installer/
build_installer_temp/
build_standalone_temp/
dist_standalone_temp/
*.spec
*.spec.bak

# Vulkan & Hardware Libraries
vulkan_llama/
**/vulkan_llama/
requirements/vulkan_llama/
**/requirements/vulkan_llama/

# Development & Benchmark Tools
tools/
**/tools/
A.U.R.A. Source/tools/
**/A.U.R.A. Source/tools/

# Python Cache & Bytecode
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# OS & IDE Files
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo

# Local Chat / Log Temp files
*.log
logs/
**/logs/