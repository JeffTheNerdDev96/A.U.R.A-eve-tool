# ==============================================================================
# Git Ignore Rules for A.U.R.A. EVE Tool
# ==============================================================================

# 1. Neural Model Weights (Exceeds GitHub 100MB / 2GB limit; kept local only)
*.gguf
*.bin
*.onnx
*.safetensors
*.pt
models/
**/models/

# 2. Training Datasets & Cloud Pipelines (Internal development only)
training/
**/training/

# 3. Local Builds, Distro Packages & Installers
A.U.R.A Distro/
**/A.U.R.A Distro/
build/
dist/
build_installer_temp/
build_standalone_temp/
dist_standalone_temp/
*.spec
*.spec.bak
*.exe
*.dll
*.so
*.dylib
*.whl
*.zip
*.7z
*.tar.gz

# 4. Developer Tools, Build Output & Temporary Workspaces
tools/
**/tools/
A.U.R.A. Source/tools/
**/A.U.R.A. Source/tools/
build_installer_temp/
**/build_installer_temp/
build_standalone_temp/
**/build_standalone_temp/
build_launcher_temp/
**/build_launcher_temp/
dist_standalone_temp/
**/dist_standalone_temp/
scratch/
**/scratch/

# 5. Python Cache, Bytecode & Virtual Environments
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
venv/
**/venv/
venv_app/
**/venv_app/
env/
ENV/
.venv/
requirements/venv/
